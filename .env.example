# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (all inference) ---
# Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
# OpenAI-compatible base URL, per https://docs.tokenfactory.nebius.com/quickstart
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Nemotron 3 model IDs (confirm with `uv run python scripts/check_models.py`).
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Escalation judge tier: ultra | super | nano. Falls back to super if Ultra isn't set.
JUDGE_TIER=ultra

# --- Tavily (research skill) ---
# Get a key at https://app.tavily.com/
TAVILY_API_KEY=

# --- Telegram (messaging skill) ---
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Your own chat ID. scripts/check_telegram.py prints it when you send /start.
# Only this chat counts as "self".
TELEGRAM_CHAT_ID=
# Optional: a second chat YOU control, standing in for the attacker in the
# naive-agent demo. In DEMO_MODE, messages to any other chat are never delivered.
TELEGRAM_DEMO_ATTACKER_CHAT_ID=

# --- Demo mode ---
# true: fetch_url only reaches FETCH_ALLOWLIST hosts, Telegram only delivers to
# your own (or the demo attacker) chat, and `tripwire chat --agent naive` is allowed.
DEMO_MODE=true
DEMO_FILES_DIR=demo/private
FETCH_ALLOWLIST=127.0.0.1
NOTES_DIR=data/notes
DATA_DIR=data

# --- Planner ---
# The user the assistant serves, named in the system prompt in both modes.
USER_NAME=
PLANNER_MAX_STEPS=8
# native (function calling) | json (JSON-action fallback)
PLANNER_TOOL_MODE=native
# How many past turns stay in context. Untrusted taint drops when the turn that
# pulled it in falls out of this window (or on /new).
PLANNER_CONTEXT_TURNS=8
