# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (all inference) ---
# Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
# OpenAI-compatible base URL, per https://docs.tokenfactory.nebius.com/quickstart
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Nemotron 3 model IDs. Leave blank, run `uv run python scripts/check_models.py`,
# then paste the IDs it prints here.
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# --- Tavily (research skill) ---
# Get a key at https://app.tavily.com/
TAVILY_API_KEY=

# --- Telegram (messaging skill) ---
# Create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=
# Your own chat ID. scripts/check_telegram.py prints it when you send /start.
TELEGRAM_CHAT_ID=
